# Copy to .env for local development. Never commit the real .env file (it is in .gitignore).

# --- selfheal_pgvector (scripts, explorer) ---
SELFHEAL_DSN=dbname=selfheal user=svuser password=replace-me host=127.0.0.1 port=5432

# --- kb_web (Flask app, see kb_web/README.md) ---
# generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me
# local docker-compose database, or in the cloud the Supabase session-pooler URI (postgresql://...:5432/postgres)
DATABASE_URL=postgresql://kb:replace-me@127.0.0.1:5433/securitykb
KB_EMBEDDER=minilm
# 0 only when serving over plain http on localhost
SESSION_COOKIE_SECURE=0
