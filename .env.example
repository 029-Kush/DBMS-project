# Copy to .env for local development. Never commit the real .env file.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://svuser:replace-me@127.0.0.1:5432/selfheal
SELFHEAL_DSN=dbname=selfheal user=svuser password=replace-me host=127.0.0.1 port=5432
CORS_ALLOWED_ORIGINS=http://localhost:5173
